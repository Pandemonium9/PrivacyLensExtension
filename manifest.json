{
  "manifest_version": 3,
  "name": "PrivacyLens",
  "version": "0.1.3",
  "description": "Instant plain-language privacy policy summaries.",

  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "https://api.example.com/*"
  ],

  "background": {
    "service_worker": "background/worker.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PrivacyLens"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/tldts.umd.min.js", "lib/Readability.js", "content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}
